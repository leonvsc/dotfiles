{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "blocks": [
    {
      "alignment": "left",
      "segments": [
        {
          "background": "#ffffff",
          "foreground": "#000000",
          "leading_diamond": "\ue0b6",
          "style": "diamond",
          "template": " {{ if .WSL }}WSL at {{ end }}{{ .Icon }} ",
          "trailing_diamond": "\ue0b4",
          "type": "os"
        },
        {
          "background": "#0000ff",
          "foreground": "#000000",
          "powerline_symbol": "\ue0b4",
          "options": {
            "style": "full"
          },
          "style": "powerline",
          "template": " \uf0e7 ",
          "type": "root"
        },
        {
          "background": "#0000ff",
          "foreground": "#ffffff",
          "powerline_symbol": "\ue0b4",
          "options": {
            "style": "full"
          },
          "style": "powerline",
          "template": " {{ .Path }} ",
          "type": "path"
        },
        {
          "background": "#D4E157",
          "foreground": "#000000",
          "powerline_symbol": "\ue0b4",
          "style": "powerline",
          "template": " {{ .HEAD }} ",
          "type": "git"
        },
        {
          "foreground": "#D4E157",
          "foreground_templates": [
            "{{ if gt .Code 0 }}#FF5252{{ end }}"
          ],
          "options": {
            "always_enabled": true
          },
          "style": "plain",
          "template": " ❯ ",
          "type": "status"
        }
      ],
      "type": "prompt"
    },
    {
      "segments": [
        {
          "background": "#D4E157",
          "foreground": "#000000",
          "leading_diamond": "\ue0b6",
          "options": {
            "always_enabled": true
          },
          "style": "diamond",
          "template": " {{ if eq .Code 0 }}✓{{ else }}✗ {{ .Code }}{{ end }} ",
          "trailing_diamond": "\ue0b4",
          "type": "status"
        },
        {
          "background": "#D4E157",
          "foreground": "#000000",
          "powerline_symbol": "\ue0b4",
          "options": {
            "threshold": 500,
            "style": "round"
          },
          "style": "powerline",
          "template": " {{ .FormattedMs }} ",
          "type": "executiontime"
        },
        {
          "background": "#ffffff",
          "foreground": "#000000",
          "options": {
            "time_format": "15:04:05"
          },
          "style": "diamond",
          "template": " {{ .CurrentDate | date .Format }} ",
          "leading_diamond": "\ue0b6",
          "trailing_diamond": "\ue0b4",
          "type": "time"
        }
      ],
      "type": "rprompt"
    }
  ],
  "version": 4,
  "transient_prompt": {
    "background": "transparent",
    "foreground": "#D4E157",
    "template": "❯ "
  }
}
